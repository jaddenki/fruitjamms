---
import {
    PIXEL_CELL,
    SHAPE_GRIDS,
    gridDimensions,
    gridToGooRects,
} from "../lib/gooGrids";
import BottomBloom from "./BottomBloom.astro";

interface Props {
    mascotGrid: string[];
}
const { mascotGrid } = Astro.props;

const mascotDims = gridDimensions(mascotGrid);
const mascotRects = gridToGooRects(mascotGrid, "#F020A0");

const crosses = [
    { id: "orange", color: "#ff940f", left: "7%", top: "38%", shape: "cross" as const },
    { id: "lime", color: "#BDED00", left: "46%", top: "15%", shape: "plus" as const },
    { id: "blue", color: "#2535E8", left: "63%", top: "8%", shape: "cross" as const },
    { id: "green", color: "#00C44E", left: "79%", top: "58%", shape: "diamond" as const },
];
---

<div id="scene">
    <canvas id="fluid-bg" aria-hidden="true"></canvas>

    {
        crosses.map(({ id, color, left, top, shape }) => {
            const vb = gridDimensions(SHAPE_GRIDS[shape]);
            return (
                <div class={`cross-wrap ${id}`} data-goo style={`left:${left};top:${top};`}>
                    <svg
                        width={vb.w}
                        height={vb.h}
                        viewBox={`0 0 ${vb.w} ${vb.h}`}
                        xmlns="http://www.w3.org/2000/svg"
                        shape-rendering="crispEdges"
                        overflow="visible"
                    >
                        <g
                            class="goo-layer"
                            filter="url(#gooey)"
                            set:html={gridToGooRects(SHAPE_GRIDS[shape], color)}
                        />
                    </svg>
                </div>
            );
        })
    }

    <div
        id="mascot"
        class="cross-wrap"
        data-goo
        style="left:calc(50% - 110px);top:calc(50% - 350px);visibility:hidden;"
    >
        <svg
            width={mascotDims.w}
            height={mascotDims.h}
            viewBox={`0 0 ${mascotDims.w} ${mascotDims.h}`}
            xmlns="http://www.w3.org/2000/svg"
            shape-rendering="crispEdges"
            overflow="visible"
        >
            <g class="goo-layer" filter="url(#gooey)" set:html={mascotRects} />
        </svg>
    </div>

    <BottomBloom />
</div>

<script>
    import { gsap } from "gsap";

    const stage = document.querySelector<HTMLElement>("#stage")!;
    const scene = document.querySelector<HTMLElement>("#scene")!;
    const palette = ["#ff940f", "#BDED00", "#2535E8", "#00C44E", "#F020A0", "#FF28A8", "#28E0C8"];
    const spawned: HTMLElement[] = [];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const mascot = document.querySelector<HTMLElement>("#mascot")!;
    const copy = document.querySelector<HTMLElement>("#studio-intro .copy")!;
    const positionMascot = () => {
        const bounds = scene.getBoundingClientRect();
        const text = copy.getBoundingClientRect();
        const size = window.innerWidth <= 480 ? 144 : 220;
        const svg = mascot.querySelector("svg")!;
        svg.setAttribute("width", String(size));
        svg.setAttribute("height", String(size));
        mascot.style.left = `${(bounds.width - size) / 2}px`;
        mascot.style.top = `${Math.max(20, text.top - bounds.top - size - 64)}px`;
        mascot.style.visibility = "visible";
    };
    positionMascot();
    new ResizeObserver(positionMascot).observe(copy);
    window.addEventListener("resize", positionMascot);
    document.fonts.ready.then(positionMascot);

    stage.addEventListener("click", (event) => {
        if (window.__gooDidDrag?.() || !window.__gooSpawnHtml) return;
        const keys = window.__gooShapeKeys ?? ["cross", "plus", "diamond"];
        const shape = keys[Math.floor(Math.random() * keys.length)];
        const color = palette[Math.floor(Math.random() * palette.length)];
        const wrap = document.createElement("div");
        wrap.className = "cross-wrap spawned";
        wrap.dataset.goo = "";
        wrap.innerHTML = window.__gooSpawnHtml(color, shape);
        const svg = wrap.querySelector("svg")!;
        const bounds = scene.getBoundingClientRect();
        wrap.style.left = `${event.clientX - bounds.left - Number(svg.getAttribute("width")) / 2}px`;
        wrap.style.top = `${event.clientY - bounds.top - Number(svg.getAttribute("height")) / 2}px`;
        scene.appendChild(wrap);
        window.__gooRegister?.(wrap);
        spawned.push(wrap);

        gsap.fromTo(svg,
            { opacity: 0, scale: reducedMotion.matches ? 1 : 0.9, transformOrigin: "50% 50%" },
            { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" },
        );

        if (spawned.length > 40) {
            const oldest = spawned.shift()!;
            gsap.to(oldest, {
                opacity: 0,
                duration: 0.2,
                onComplete: () => {
                    window.__gooUnregister?.(oldest);
                    oldest.remove();
                },
            });
        }
    });
</script>
