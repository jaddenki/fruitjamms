<script type="module" is:inline>
    import * as THREE from "https://esm.sh/three@0.170.0";

    const canvas = document.getElementById("fluid-bg");
    const FRAME = 14;
    let W = window.innerWidth - FRAME * 2;
    let H = window.innerHeight - FRAME * 2;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: false });
    renderer.setSize(W, H, false);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.autoClear = false;

    const SIM = 128;
    const ITERS = 14;
    const VEL_DISS = 0.99;
    const CURL_STR = 26;
    const SPLAT_F = 5000;
    const SPLAT_R = 0.0022;
    const WARP_STR = 0.016;

    const tType = THREE.HalfFloatType;
    function mkRT(w, h) {
        return new THREE.WebGLRenderTarget(w, h, {
            minFilter: THREE.LinearFilter,
            magFilter: THREE.LinearFilter,
            format: THREE.RGBAFormat,
            type: tType,
            depthBuffer: false,
        });
    }
    class FBO {
        constructor(w, h) {
            this.r = mkRT(w, h);
            this.w = mkRT(w, h);
        }
        swap() {
            const t = this.r;
            this.r = this.w;
            this.w = t;
        }
    }

    const velFBO = new FBO(SIM, SIM);
    const presFBO = new FBO(SIM, SIM);
    const divRT = mkRT(SIM, SIM);
    const curlRT = mkRT(SIM, SIM);
    const blurRT1 = mkRT(SIM, SIM);
    const blurRT2 = mkRT(SIM, SIM);

    const fxScene = new THREE.Scene();
    const fxCam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const quad = new THREE.Mesh(new THREE.PlaneGeometry(2, 2));
    fxScene.add(quad);

    function runFX(mat, rt) {
        quad.material = mat;
        renderer.setRenderTarget(rt ?? null);
        renderer.render(fxScene, fxCam);
    }

    const VS = `varying vec2 vUv; void main(){ vUv=uv; gl_Position=vec4(position.xy,0.,1.); }`;
    function mkMat(fs, uniforms) {
        return new THREE.ShaderMaterial({
            vertexShader: VS,
            fragmentShader: "precision highp float;\n" + fs,
            uniforms,
            depthTest: false,
            depthWrite: false,
        });
    }

    const advectMat = mkMat(
        `uniform sampler2D uVel,uSrc; uniform float uDt,uDiss; varying vec2 vUv;
   void main(){ gl_FragColor=uDiss*texture2D(uSrc,vUv-uDt*texture2D(uVel,vUv).xy); }`,
        {
            uVel: { value: null },
            uSrc: { value: null },
            uDt: { value: 0.016 },
            uDiss: { value: VEL_DISS },
        },
    );
    const divMat = mkMat(
        `uniform sampler2D uVel; uniform vec2 uT; varying vec2 vUv;
   void main(){
     float L=texture2D(uVel,vUv-vec2(uT.x,0)).x,R=texture2D(uVel,vUv+vec2(uT.x,0)).x;
     float B=texture2D(uVel,vUv-vec2(0,uT.y)).y,T=texture2D(uVel,vUv+vec2(0,uT.y)).y;
     gl_FragColor=vec4(0.5*(R-L+T-B),0,0,1); }`,
        {
            uVel: { value: null },
            uT: { value: new THREE.Vector2(1 / SIM, 1 / SIM) },
        },
    );
    const presMat = mkMat(
        `uniform sampler2D uPres,uDiv; uniform vec2 uT; varying vec2 vUv;
   void main(){
     float L=texture2D(uPres,vUv-vec2(uT.x,0)).x,R=texture2D(uPres,vUv+vec2(uT.x,0)).x;
     float B=texture2D(uPres,vUv-vec2(0,uT.y)).x,T=texture2D(uPres,vUv+vec2(0,uT.y)).x;
     gl_FragColor=vec4((L+R+B+T-texture2D(uDiv,vUv).x)*0.25,0,0,1); }`,
        {
            uPres: { value: null },
            uDiv: { value: null },
            uT: { value: new THREE.Vector2(1 / SIM, 1 / SIM) },
        },
    );
    const gradMat = mkMat(
        `uniform sampler2D uPres,uVel; uniform vec2 uT; varying vec2 vUv;
   void main(){
     float L=texture2D(uPres,vUv-vec2(uT.x,0)).x,R=texture2D(uPres,vUv+vec2(uT.x,0)).x;
     float B=texture2D(uPres,vUv-vec2(0,uT.y)).x,T=texture2D(uPres,vUv+vec2(0,uT.y)).x;
     gl_FragColor=vec4(texture2D(uVel,vUv).xy-0.5*vec2(R-L,T-B),0,1); }`,
        {
            uPres: { value: null },
            uVel: { value: null },
            uT: { value: new THREE.Vector2(1 / SIM, 1 / SIM) },
        },
    );
    const curlMat = mkMat(
        `uniform sampler2D uVel; uniform vec2 uT; varying vec2 vUv;
   void main(){
     float L=texture2D(uVel,vUv-vec2(uT.x,0)).y,R=texture2D(uVel,vUv+vec2(uT.x,0)).y;
     float B=texture2D(uVel,vUv-vec2(0,uT.y)).x,T=texture2D(uVel,vUv+vec2(0,uT.y)).x;
     gl_FragColor=vec4(0.5*(R-L-T+B),0,0,1); }`,
        {
            uVel: { value: null },
            uT: { value: new THREE.Vector2(1 / SIM, 1 / SIM) },
        },
    );
    const vortMat = mkMat(
        `uniform sampler2D uVel,uCurlTex; uniform vec2 uT; uniform float uStr,uDt; varying vec2 vUv;
   void main(){
     float L=abs(texture2D(uCurlTex,vUv-vec2(uT.x,0)).x),R=abs(texture2D(uCurlTex,vUv+vec2(uT.x,0)).x);
     float B=abs(texture2D(uCurlTex,vUv-vec2(0,uT.y)).x),T=abs(texture2D(uCurlTex,vUv+vec2(0,uT.y)).x);
     gl_FragColor=vec4(texture2D(uVel,vUv).xy+normalize(vec2(T-B,R-L)+0.0001)*uStr*texture2D(uCurlTex,vUv).x*uDt,0,1); }`,
        {
            uVel: { value: null },
            uCurlTex: { value: null },
            uT: { value: new THREE.Vector2(1 / SIM, 1 / SIM) },
            uStr: { value: CURL_STR },
            uDt: { value: 0.016 },
        },
    );
    const clearMat = mkMat(
        `uniform sampler2D uTex; uniform float uVal; varying vec2 vUv;
   void main(){ gl_FragColor=uVal*texture2D(uTex,vUv); }`,
        { uTex: { value: null }, uVal: { value: 0.8 } },
    );
    const splatMat = mkMat(
        `uniform sampler2D uTex; uniform vec2 uPos; uniform vec3 uColor;
   uniform float uRadius,uAspect; varying vec2 vUv;
   void main(){
     vec2 p=vUv-uPos; p.x*=uAspect;
     gl_FragColor=vec4(texture2D(uTex,vUv).rgb+exp(-dot(p,p)/uRadius)*uColor,1.0); }`,
        {
            uTex: { value: null },
            uPos: { value: new THREE.Vector2() },
            uColor: { value: new THREE.Vector3() },
            uRadius: { value: SPLAT_R },
            uAspect: { value: W / H },
        },
    );
    const blurHMat = mkMat(
        `uniform sampler2D uTex; uniform vec2 uTexel; varying vec2 vUv;
   void main(){
     float w[9]; w[0]=0.0269;w[1]=0.0654;w[2]=0.1213;w[3]=0.1747;w[4]=0.1974;
     w[5]=0.1747;w[6]=0.1213;w[7]=0.0654;w[8]=0.0269;
     vec4 c=vec4(0.0);
     for(int i=0;i<9;i++) c+=texture2D(uTex,vUv+vec2(float(i-4)*uTexel.x*2.0,0.0))*w[i];
     gl_FragColor=c; }`,
        {
            uTex: { value: null },
            uTexel: { value: new THREE.Vector2(1 / SIM, 1 / SIM) },
        },
    );
    const blurVMat = mkMat(
        `uniform sampler2D uTex; uniform vec2 uTexel; varying vec2 vUv;
   void main(){
     float w[9]; w[0]=0.0269;w[1]=0.0654;w[2]=0.1213;w[3]=0.1747;w[4]=0.1974;
     w[5]=0.1747;w[6]=0.1213;w[7]=0.0654;w[8]=0.0269;
     vec4 c=vec4(0.0);
     for(int i=0;i<9;i++) c+=texture2D(uTex,vUv+vec2(0.0,float(i-4)*uTexel.y*2.0))*w[i];
     gl_FragColor=c; }`,
        {
            uTex: { value: null },
            uTexel: { value: new THREE.Vector2(1 / SIM, 1 / SIM) },
        },
    );
    const displayMat = mkMat(
        `uniform sampler2D uVelBlur;
   uniform float uDisplace;
   varying vec2 vUv;

   float hash(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
   float noise(vec2 p){
     vec2 g=floor(p); vec2 f=fract(p);
     f=f*f*(3.0-2.0*f);
     return mix(mix(hash(g),hash(g+vec2(1,0)),f.x),
                mix(hash(g+vec2(0,1)),hash(g+vec2(1,1)),f.x),f.y);
   }

   void main(){
     vec2 vel = texture2D(uVelBlur, vUv).xy;
     float mag = length(vel);
     float mask = 1.0 - exp(-mag * 22.0);
     vec2 warpedUV = clamp(vUv + vel * uDisplace * mask, 0.0, 1.0);
     float n  = noise(warpedUV * 520.0) * 0.011;
     float n2 = noise(warpedUV * 280.0 + 7.3) * 0.006;
     vec3 base = vec3(0.0196, 0.0, 0.0196);
     gl_FragColor = vec4(base + (n + n2), 1.0);
   }`,
        { uVelBlur: { value: null }, uDisplace: { value: WARP_STR } },
    );

    const ENC_SIZE = 16;
    const velEncRT = new THREE.WebGLRenderTarget(ENC_SIZE, ENC_SIZE, {
        minFilter: THREE.LinearFilter,
        magFilter: THREE.LinearFilter,
        format: THREE.RGBAFormat,
        type: THREE.UnsignedByteType,
        depthBuffer: false,
    });
    const velEncMat = mkMat(
        `uniform sampler2D uVel; varying vec2 vUv;
   void main(){
     vec2 v = clamp(texture2D(uVel, vUv).xy * 0.005 + 0.5, 0.0, 1.0);
     gl_FragColor = vec4(v, 0.0, 1.0);
   }`,
        { uVel: { value: null } },
    );
    const velPixels = new Uint8Array(ENC_SIZE * ENC_SIZE * 4);

    const sceneEl = document.getElementById("scene");
    let prevMenuTop = null;

    // ── 2D Physics ──────────────────────────────────────────────────────────
    const physicsMap = new Map();
    let physicsT = 0;

    const DRAG = 0.975;
    const ROT_DRAG = 0.9;
    const WALL_SOFT = 12;
    const WALL_SPRING = 88;
    const WALL_REST = 0.42;
    const WALL_TANGENT = 0.94;
    const WALL_VEL_MIN = 1.1;
    const MENU_FIELD = 58;
    const MENU_PUSH = 88;
    const MENU_SEP_SPEED = 11;
    const MENU_RISE_COUPLE = 0.68;
    const MENU_RISE_SIDE = 0.32;
    const COLL_REST = 0.06;
    const COLL_SLOP = 0.35;
    const COLL_SEP = 0.38;
    const REST_VEL = 22;
    const DRIFT_AMP = 24;
    const FLUID_MULT = 260;
    const MAX_SPEED = 320;

    function getSceneDims() {
        const sr = sceneEl.getBoundingClientRect();
        return { W: sr.width, H: sr.height, left: sr.left, top: sr.top };
    }

    function wallRestitution(impact) {
        return Math.min(WALL_REST, 0.18 + impact * 0.0028);
    }

    /** Open nav panel in scene-local coords (null when collapsed). */
    function getMenuObstacle(scene) {
        const pill = document.getElementById("nav-pill");
        if (!pill?.classList.contains("is-open")) return null;
        const r = pill.getBoundingClientRect();
        const left = r.left - scene.left;
        const right = r.right - scene.left;
        const top = r.top - scene.top;
        const bottom = r.bottom - scene.top;
        if (right <= 0 || left >= scene.W || bottom <= 0 || top >= scene.H) {
            return null;
        }
        return {
            left: Math.max(0, left),
            right: Math.min(scene.W, right),
            top: Math.max(0, top),
            bottom: Math.min(scene.H, bottom),
        };
    }

    function overlapsObstacleX(mx, x, obs) {
        return x + mx > obs.left && x - mx < obs.right;
    }

    function menuEscapeNormal(bx, by, obs) {
        const cpx = Math.max(obs.left, Math.min(bx, obs.right));
        const cpy = Math.max(obs.top, Math.min(by, obs.bottom));
        let dx = bx - cpx;
        let dy = by - cpy;
        let dist = Math.hypot(dx, dy);
        if (dist < 0.001) {
            const toLeft = bx - obs.left;
            const toRight = obs.right - bx;
            const toTop = by - obs.top;
            const toBottom = obs.bottom - by;
            const min = Math.min(toLeft, toRight, toTop, toBottom);
            if (min === toTop) {
                dx = 0;
                dy = -1;
            } else if (min === toBottom) {
                dx = 0;
                dy = 1;
            } else if (min === toLeft) {
                dx = -1;
                dy = 0;
            } else {
                dx = 1;
                dy = 0;
            }
            dist = 1;
        }
        return { nx: dx / dist, ny: dy / dist, dist };
    }

    /** Soft, localized push from the open menu — no hard snaps. */
    function applyMenuForces(b, mx, my, obs, dt, menuRiseVy) {
        const rad = Math.max(mx, my, b.rad);
        const reach = MENU_FIELD + rad;
        const { nx, ny, dist } = menuEscapeNormal(b.x, b.y, obs);
        const gap = dist - rad;
        const contactX = Math.max(obs.left, Math.min(b.x, obs.right));

        if (gap < reach) {
            const t = 1 - Math.max(0, gap) / reach;
            const ease = t * t * (3 - 2 * t);
            const force = ease * MENU_PUSH;
            b.vx += nx * force * dt;
            b.vy += ny * force * dt;
        }

        if (menuRiseVy < -0.5) {
            const vertGap = obs.top - (b.y + my);
            if (vertGap < reach && vertGap > -my) {
                const horiz = Math.abs(b.x - contactX);
                const hFall = Math.max(0, 1 - horiz / (mx + MENU_FIELD * 0.45));
                const vFall = Math.max(0, 1 - Math.max(0, vertGap) / reach);
                const local = hFall * vFall;
                if (local > 0) {
                    const side = (b.x - contactX) / Math.max(mx, 20);
                    b.vy += menuRiseVy * local * MENU_RISE_COUPLE;
                    b.vx += side * -menuRiseVy * local * MENU_RISE_SIDE;
                }
            }
        }

        if (overlapsObstacleX(mx, b.x, obs)) {
            const edgeGap = obs.top - (b.y + my);
            if (edgeGap > 0 && edgeGap < reach) {
                const edgeT = 1 - edgeGap / reach;
                const edgeEase = edgeT * edgeT;
                b.vy -= edgeEase * MENU_PUSH * 0.55 * dt;
                b.vx += ((b.x - contactX) / Math.max(mx, 20)) * edgeEase * MENU_PUSH * 0.22 * dt;
            }
        }
    }

    function softenMenuOverlap(b, mx, my, obs, dt) {
        const rad = Math.max(mx, my, b.rad);
        const { nx, ny, dist } = menuEscapeNormal(b.x, b.y, obs);
        const gap = dist - rad;
        if (gap >= 0) return;

        const overlap = -gap;
        const sep = overlap * Math.min(1, MENU_SEP_SPEED * dt);
        b.x += nx * sep;
        b.y += ny * sep;
        const vn = b.vx * nx + b.vy * ny;
        if (vn < 0) {
            const rest = wallRestitution(-vn) * 0.7;
            b.vx -= vn * nx * (1 + rest);
            b.vy -= vn * ny * (1 + rest);
        }
    }

    function resolveSceneWalls(b, mx, my, scene) {
        if (b.x < mx) {
            b.x = mx;
            if (b.vx < 0) {
                const impact = -b.vx;
                b.vx = impact * wallRestitution(impact);
                b.vy *= WALL_TANGENT;
            }
        }
        if (b.x > scene.W - mx) {
            b.x = scene.W - mx;
            if (b.vx > 0) {
                const impact = b.vx;
                b.vx = -impact * wallRestitution(impact);
                b.vy *= WALL_TANGENT;
            }
        }
        if (b.y < my) {
            b.y = my;
            if (b.vy < 0) {
                const impact = -b.vy;
                b.vy = impact * wallRestitution(impact);
                b.vx *= WALL_TANGENT;
            }
        }
        if (b.y > scene.H - my) {
            b.y = scene.H - my;
            if (b.vy > 0) {
                const impact = b.vy;
                b.vy = -impact * wallRestitution(impact);
                b.vx *= WALL_TANGENT;
            }
        }
    }

    /** Match visual bounds — half the shorter side so shapes touch edge-to-edge */
    function collisionRadius(w, h) {
        return Math.min(w, h) * 0.5;
    }

    function readBodySize(el) {
        const svg = el.querySelector("svg");
        if (svg) {
            const w = parseFloat(svg.getAttribute("width") ?? "0");
            const h = parseFloat(svg.getAttribute("height") ?? "0");
            if (w > 0 && h > 0) return { w, h };
        }
        const r = el.getBoundingClientRect();
        return { w: r.width, h: r.height };
    }

    function refreshBodyMetrics(b, el) {
        const { w, h } = readBodySize(el);
        b.w = w;
        b.h = h;
        b.rad = collisionRadius(w, h);
    }

    function applyBodyToEl(el, b) {
        el.style.bottom = "auto";
        el.style.right = "auto";
        el.style.left = b.x - b.w * 0.5 + "px";
        el.style.top = b.y - b.h * 0.5 + "px";
        el.style.rotate = b.rot + "deg";
        el.style.scale = b.scale ?? "1";
        el.style.translate = "";
    }

    function ensureBody(el, scene) {
        if (physicsMap.has(el)) return physicsMap.get(el);
        const { w, h } = readBodySize(el);
        const r = el.getBoundingClientRect();
        const cx = r.left - scene.left + r.width * 0.5;
        const cy = r.top - scene.top + r.height * 0.5;
        const startRot = parseFloat(el.dataset.startRot ?? "0");
        const body = {
            x: cx,
            y: cy,
            vx: (Math.random() - 0.5) * 60,
            vy: (Math.random() - 0.5) * 60,
            rot: startRot,
            rotV: (Math.random() - 0.5) * 1.5,
            w,
            h,
            rad: collisionRadius(w, h),
            phase: Math.random() * Math.PI * 2,
            scale: "1",
        };
        physicsMap.set(el, body);
        el.style.animation = "none";
        el.style.bottom = "auto";
        el.style.right = "auto";
        el.style.left = cx - w * 0.5 + "px";
        el.style.top = cy - h * 0.5 + "px";
        return body;
    }

    function resolveCollisions(bodies) {
        for (let pass = 0; pass < 2; pass++) {
            for (let i = 0; i < bodies.length; i++) {
                for (let j = i + 1; j < bodies.length; j++) {
                    resolveBodyPair(bodies[i], bodies[j]);
                }
            }
        }
    }

    function resolveBodyPair(aEntry, bEntry, staticB = null) {
        const a = aEntry.b;
        const b = bEntry.b;
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const minDist = a.rad + b.rad;
        const dist2 = dx * dx + dy * dy;
        if (dist2 >= minDist * minDist || dist2 < 0.0001) return;

        const dist = Math.sqrt(dist2);
        const nx = dx / dist;
        const ny = dy / dist;
        const overlap = minDist - dist;

        if (overlap > COLL_SLOP) {
            const corr = (overlap - COLL_SLOP) * COLL_SEP;
            if (staticB === bEntry) {
                a.x += nx * corr * 2;
                a.y += ny * corr * 2;
            } else if (staticB === aEntry) {
                b.x -= nx * corr * 2;
                b.y -= ny * corr * 2;
            } else {
                a.x += nx * corr;
                a.y += ny * corr;
                b.x -= nx * corr;
                b.y -= ny * corr;
            }
        }

        const bvx = staticB === bEntry ? 0 : b.vx;
        const bvy = staticB === bEntry ? 0 : b.vy;
        const avx = staticB === aEntry ? 0 : a.vx;
        const avy = staticB === aEntry ? 0 : a.vy;
        const relVn = (avx - bvx) * nx + (avy - bvy) * ny;
        if (relVn >= 0) return;

        const impulse = -(1 + COLL_REST) * relVn;
        if (staticB === bEntry) {
            a.vx += impulse * nx;
            a.vy += impulse * ny;
        } else if (staticB === aEntry) {
            b.vx -= impulse * nx;
            b.vy -= impulse * ny;
        } else {
            const half = impulse * 0.5;
            a.vx += half * nx;
            a.vy += half * ny;
            b.vx -= half * nx;
            b.vy -= half * ny;
            if (Math.abs(relVn) < REST_VEL) {
                a.vx *= 0.8;
                a.vy *= 0.8;
                b.vx *= 0.8;
                b.vy *= 0.8;
            }
        }
    }

    function getAnchorBodies(scene) {
        return [
            ...document.querySelectorAll("#scene [data-goo][data-no-float]"),
        ].map((el) => {
            const { w, h } = readBodySize(el);
            const r = el.getBoundingClientRect();
            return {
                el,
                b: {
                    x: r.left - scene.left + r.width * 0.5,
                    y: r.top - scene.top + r.height * 0.5,
                    vx: 0,
                    vy: 0,
                    w,
                    h,
                    rad: collisionRadius(w, h),
                },
            };
        });
    }

    function resolveAnchorCollisions(floatBodies, anchorBodies) {
        for (let pass = 0; pass < 2; pass++) {
            for (const floatEntry of floatBodies) {
                if (floatEntry.el.classList.contains("is-pulling")) continue;
                for (const anchorEntry of anchorBodies) {
                    resolveBodyPair(floatEntry, anchorEntry, anchorEntry);
                }
            }
        }
    }

    function tickPhysics(dt) {
        velEncMat.uniforms.uVel.value = blurRT2.texture;
        runFX(velEncMat, velEncRT);
        renderer.readRenderTargetPixels(
            velEncRT,
            0,
            0,
            ENC_SIZE,
            ENC_SIZE,
            velPixels,
        );

        physicsT += dt;
        const scene = getSceneDims();
        const menuObs = getMenuObstacle(scene);
        let menuRiseVy = 0;
        if (menuObs && prevMenuTop !== null) {
            menuRiseVy = (menuObs.top - prevMenuTop) / Math.max(dt, 0.001);
        }
        prevMenuTop = menuObs?.top ?? null;
        // [data-no-float] elements (e.g. the floor-anchored bloom clusters)
        // opt out of the drift/collision physics entirely and keep the
        // fixed position/bottom they were authored with.
        const els = [
            ...document.querySelectorAll("#scene [data-goo]:not([data-no-float])"),
        ];

        for (const k of physicsMap.keys()) {
            if (!els.includes(k)) physicsMap.delete(k);
        }

        const bodies = els.map((el) => ({ el, b: ensureBody(el, scene) }));

        bodies.forEach(({ el, b }) => {
            if (!el.classList.contains("is-pulling")) refreshBodyMetrics(b, el);
        });

        bodies.forEach(({ b }) => {
            const u = Math.max(0, Math.min(1, b.x / scene.W));
            const v = Math.max(0, Math.min(1, 1 - b.y / scene.H));
            const px = Math.min(ENC_SIZE - 1, Math.floor(u * ENC_SIZE));
            const py = Math.min(ENC_SIZE - 1, Math.floor(v * ENC_SIZE));
            const idx = (py * ENC_SIZE + px) * 4;
            const fvx = (velPixels[idx] / 255.0 - 0.5) / 0.005;
            const fvy = (velPixels[idx + 1] / 255.0 - 0.5) / 0.005;
            b.vx += fvx * FLUID_MULT * dt;
            b.vy -= fvy * FLUID_MULT * dt;
            b.rotV += fvx * 0.5 * dt;
        });

        bodies.forEach(({ b }) => {
            b.vx += Math.sin(physicsT * 0.65 + b.phase) * DRIFT_AMP * dt;
            b.vy += Math.cos(physicsT * 0.48 + b.phase + 1.3) * DRIFT_AMP * dt;
        });

        bodies.forEach(({ el, b }) => {
            if (el.classList.contains("is-pulling")) {
                b.vx = 0;
                b.vy = 0;
                b.rotV = 0;
                return;
            }

            const mx = b.w * 0.5;
            const my = b.h * 0.5;
            const penL = mx + WALL_SOFT - b.x;
            const penR = b.x - (scene.W - mx - WALL_SOFT);
            const penT = my + WALL_SOFT - b.y;
            const penB = b.y - (scene.H - my - WALL_SOFT);
            if (penL > 0) b.vx += penL * WALL_SPRING * dt;
            if (penR > 0) b.vx -= penR * WALL_SPRING * dt;
            if (penT > 0) b.vy += penT * WALL_SPRING * dt;
            if (penB > 0) b.vy -= penB * WALL_SPRING * dt;
            if (menuObs) applyMenuForces(b, mx, my, menuObs, dt, menuRiseVy);

            b.vx *= DRAG;
            b.vy *= DRAG;
            b.rotV *= ROT_DRAG;
            const spd = Math.sqrt(b.vx * b.vx + b.vy * b.vy);
            if (spd > MAX_SPEED) {
                b.vx *= MAX_SPEED / spd;
                b.vy *= MAX_SPEED / spd;
            }
            b.x += b.vx * dt;
            b.y += b.vy * dt;
            b.rot += b.rotV * dt * 35;
        });

        resolveCollisions(bodies);
        resolveAnchorCollisions(bodies, getAnchorBodies(scene));

        bodies.forEach(({ el, b }) => {
            if (el.classList.contains("is-pulling")) return;

            const mx = b.w * 0.5;
            const my = b.h * 0.5;
            resolveSceneWalls(b, mx, my, scene);
            if (menuObs) softenMenuOverlap(b, mx, my, menuObs, dt);

            if (Math.abs(b.vx) < WALL_VEL_MIN) b.vx = 0;
            if (Math.abs(b.vy) < WALL_VEL_MIN) b.vy = 0;

            const spd = Math.sqrt(b.vx * b.vx + b.vy * b.vy);
            b.scale = (1 + spd * 0.0004).toString();
            applyBodyToEl(el, b);
        });
    }

    function doSplat(x, y, fx, fy) {
        splatMat.uniforms.uAspect.value = W / H;
        splatMat.uniforms.uTex.value = velFBO.r.texture;
        splatMat.uniforms.uPos.value.set(x, y);
        splatMat.uniforms.uColor.value.set(fx, fy, 0);
        splatMat.uniforms.uRadius.value = SPLAT_R;
        runFX(splatMat, velFBO.w);
        velFBO.swap();
    }

    // ── Mouse pointer ────────────────────────────────────────────────────────
    const ptr = { x: 0.5, y: 0.5, px: 0.5, py: 0.5, moved: false };

    window.addEventListener("mousemove", (e) => {
        const r = canvas.getBoundingClientRect();
        ptr.x = (e.clientX - r.left) / r.width;
        ptr.y = 1 - (e.clientY - r.top) / r.height;
        ptr.moved = true;
    });

    // ── Gyroscope: tilt → virtual pointer → fluid splat ─────────────────────
    const gyroPtr = { x: 0.5, y: 0.5, px: 0.5, py: 0.5, active: false };

    function onDeviceOrientation(e) {
        if (e.beta === null || e.gamma === null) return;
        gyroPtr.x = (Math.max(-90, Math.min(90, e.gamma)) + 90) / 180;
        gyroPtr.y = 1 - (Math.max(-90, Math.min(90, e.beta)) + 90) / 180;
        gyroPtr.active = true;
    }

    (function setupGyro() {
        if (!("DeviceOrientationEvent" in window)) return;
        if (typeof DeviceOrientationEvent.requestPermission === "function") {
            document.addEventListener(
                "touchstart",
                function req() {
                    document.removeEventListener("touchstart", req);
                    DeviceOrientationEvent.requestPermission()
                        .then((state) => {
                            if (state === "granted")
                                window.addEventListener(
                                    "deviceorientation",
                                    onDeviceOrientation,
                                );
                        })
                        .catch(() => {});
                },
                { once: true },
            );
        } else {
            window.addEventListener("deviceorientation", onDeviceOrientation);
        }
    })();

    // ── Render loop ──────────────────────────────────────────────────────────
    let last = performance.now();
    function tick(now) {
        requestAnimationFrame(tick);
        const dt = Math.min((now - last) / 1000, 0.033);
        last = now;

        if (ptr.moved) {
            const dx = ptr.x - ptr.px,
                dy = ptr.y - ptr.py;
            if (dx * dx + dy * dy > 0.0000008)
                doSplat(ptr.x, ptr.y, dx * SPLAT_F, dy * SPLAT_F);
            ptr.px = ptr.x;
            ptr.py = ptr.y;
            ptr.moved = false;
        }

        if (gyroPtr.active) {
            const dx = gyroPtr.x - gyroPtr.px;
            const dy = gyroPtr.y - gyroPtr.py;
            if (dx * dx + dy * dy > 0.0000008)
                doSplat(gyroPtr.x, gyroPtr.y, dx * SPLAT_F, dy * SPLAT_F);
            gyroPtr.px = gyroPtr.x;
            gyroPtr.py = gyroPtr.y;
        }

        advectMat.uniforms.uVel.value = advectMat.uniforms.uSrc.value =
            velFBO.r.texture;
        advectMat.uniforms.uDt.value = dt;
        advectMat.uniforms.uDiss.value = VEL_DISS;
        runFX(advectMat, velFBO.w);
        velFBO.swap();

        curlMat.uniforms.uVel.value = velFBO.r.texture;
        runFX(curlMat, curlRT);
        vortMat.uniforms.uVel.value = velFBO.r.texture;
        vortMat.uniforms.uCurlTex.value = curlRT.texture;
        vortMat.uniforms.uDt.value = dt;
        runFX(vortMat, velFBO.w);
        velFBO.swap();

        divMat.uniforms.uVel.value = velFBO.r.texture;
        runFX(divMat, divRT);
        clearMat.uniforms.uTex.value = presFBO.r.texture;
        runFX(clearMat, presFBO.w);
        presFBO.swap();
        for (let i = 0; i < ITERS; i++) {
            presMat.uniforms.uPres.value = presFBO.r.texture;
            presMat.uniforms.uDiv.value = divRT.texture;
            runFX(presMat, presFBO.w);
            presFBO.swap();
        }
        gradMat.uniforms.uPres.value = presFBO.r.texture;
        gradMat.uniforms.uVel.value = velFBO.r.texture;
        runFX(gradMat, velFBO.w);
        velFBO.swap();

        blurHMat.uniforms.uTex.value = velFBO.r.texture;
        runFX(blurHMat, blurRT1);
        blurVMat.uniforms.uTex.value = blurRT1.texture;
        runFX(blurVMat, blurRT2);
        blurHMat.uniforms.uTex.value = blurRT2.texture;
        runFX(blurHMat, blurRT1);
        blurVMat.uniforms.uTex.value = blurRT1.texture;
        runFX(blurVMat, blurRT2);

        tickPhysics(dt);

        displayMat.uniforms.uVelBlur.value = blurRT2.texture;
        quad.material = displayMat;
        renderer.setRenderTarget(null);
        renderer.setClearColor(0x050005, 1);
        renderer.clear(true, false, false);
        renderer.render(fxScene, fxCam);
    }

    requestAnimationFrame(tick);

    window.addEventListener("resize", () => {
        W = window.innerWidth - FRAME * 2;
        H = window.innerHeight - FRAME * 2;
        renderer.setSize(W, H, false);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    });
</script>
