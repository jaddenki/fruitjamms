---
import '../styles/styles.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'a product studio designing & shipping games, brand, and web work for those who want it to stick.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/img/og.png', Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <title>jamms{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ff28a8" />

    <!-- Open Graph / social preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="jamms" />
    <meta property="og:title" content={`jamms${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="jamms" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`jamms${title}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Preload images -->
    <link rel="preload" as="image" href="/img/Group 1.svg" />
    <link rel="preload" as="image" href="/img/Group 2.svg" />
    <link rel="preload" as="image" href="/img/app_icon 2.png" />
    <link rel="preload" as="image" href="/img/jadden.png" />
    <link rel="preload" as="image" href="/img/saahil.png" />
    <link rel="preload" as="image" href="/img/alicia.png" />
    <link rel="preload" as="image" href="/img/mason.png" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <ClientRouter />
  </head>
  <body>
    <!-- Pixel trail canvas (persists across page navigations) -->
    <canvas id="pixel-trail" transition:persist style="
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    "></canvas>
    
    <div class="container">
      <aside class="sidebar" transition:persist>
        <a href="/" class="logo">
          <img src="/img/Group 1.svg" alt="" class="logo-icon" />
          <span class="logo-text">jamms</span>
        </a>
        <nav class="nav">
          <a href="/projects" class="nav-link" data-nav="projects">projects</a>
          <a href="/team" class="nav-link" data-nav="team">team</a>
        </nav>
      </aside>
      <main class="content">
        <slot />
      </main>
    </div>

    <script>
      function updateActiveNav() {
        const pathname = window.location.pathname;
        const navLinks = document.querySelectorAll('.nav-link');
        
        navLinks.forEach(link => {
          link.classList.remove('active');
          const nav = link.getAttribute('data-nav');
          
          if (nav === 'projects' && (pathname.startsWith('/projects') || pathname.startsWith('/quiz'))) {
            link.classList.add('active');
          } else if (nav === 'team' && pathname.startsWith('/team')) {
            link.classList.add('active');
          }
        });
      }

      // Run on initial load
      updateActiveNav();
      
      // Run on every navigation
      document.addEventListener('astro:page-load', updateActiveNav);
    </script>

    <!-- Pixel trail effect -->
    <script is:inline>
      (function() {
        // Use global state so it persists across View Transitions
        if (!window.__pixelTrail) {
          window.__pixelTrail = {
            pixels: {},
            isDrawing: false,
            animationId: null,
            initialized: false,
            lastX: null,
            lastY: null
          };
        }
        
        const state = window.__pixelTrail;
        const PIXEL_SIZE = 24;
        const MAX_OPACITY = 0.12;
        const DRAW_OPACITY = .28;
        const FADE_RATE = 0.002;
        const PIXEL_COLOR = { r: 255, g: 145, b: 173 };
        const INTERACTIVE_SELECTORS = 'a, button, input, select, textarea, [onclick], [role="button"]';
        
        function getCanvas() {
          return document.getElementById('pixel-trail');
        }
        
        function resizeCanvas() {
          const canvas = getCanvas();
          if (canvas) {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
          }
        }
        
        function getGridKey(x, y) {
          const gridX = Math.floor(x / PIXEL_SIZE);
          const gridY = Math.floor(y / PIXEL_SIZE);
          return gridX + ',' + gridY;
        }
        
        function spawnPixel(x, y, drawing) {
          const key = getGridKey(x, y);
          const gridX = Math.floor(x / PIXEL_SIZE);
          const gridY = Math.floor(y / PIXEL_SIZE);
          const targetOpacity = drawing ? DRAW_OPACITY : MAX_OPACITY;
          
          if (!state.pixels[key] || state.pixels[key].opacity < targetOpacity * 0.5 || drawing) {
            state.pixels[key] = {
              gridX: gridX,
              gridY: gridY,
              opacity: targetOpacity * (0.7),
              permanent: drawing
            };
          }
        }
        
        // Draw a line of pixels between two points (fills gaps when moving fast)
        function drawLine(x0, y0, x1, y1, drawing) {
          const dx = x1 - x0;
          const dy = y1 - y0;
          const distance = Math.sqrt(dx * dx + dy * dy);
          
          // Step size smaller than pixel size to ensure no gaps
          const steps = Math.max(1, Math.ceil(distance / (PIXEL_SIZE * 0.5)));
          
          for (let i = 0; i <= steps; i++) {
            const t = steps === 0 ? 0 : i / steps;
            const x = x0 + dx * t;
            const y = y0 + dy * t;
            spawnPixel(x, y, drawing);
          }
        }
        
        function render() {
          const canvas = getCanvas();
          if (!canvas) {
            state.animationId = requestAnimationFrame(render);
            return;
          }
          
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            state.animationId = requestAnimationFrame(render);
            return;
          }
          
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          
          for (const key in state.pixels) {
            const pixel = state.pixels[key];
            
            if (!pixel.permanent) {
              pixel.opacity -= FADE_RATE;
              if (pixel.opacity <= 0) {
                delete state.pixels[key];
                continue;
              }
            }
            
            ctx.fillStyle = `rgba(${PIXEL_COLOR.r}, ${PIXEL_COLOR.g}, ${PIXEL_COLOR.b}, ${pixel.opacity})`;
            ctx.fillRect(
              pixel.gridX * PIXEL_SIZE,
              pixel.gridY * PIXEL_SIZE,
              PIXEL_SIZE,
              PIXEL_SIZE
            );
          }
          
          state.animationId = requestAnimationFrame(render);
        }
        
        function isInteractiveElement(el) {
          if (!el) return false;
          return el.closest(INTERACTIVE_SELECTORS) !== null;
        }
        
        function handleMouseMove(e) {
          const x = e.clientX;
          const y = e.clientY;
          
          // If we have a previous position, draw a line to fill gaps
          if (state.lastX !== null && state.lastY !== null) {
            drawLine(state.lastX, state.lastY, x, y, state.isDrawing);
          } else {
            spawnPixel(x, y, state.isDrawing);
          }
          
          state.lastX = x;
          state.lastY = y;
        }
        
        function handleMouseDown(e) {
          if (!isInteractiveElement(e.target)) {
            state.isDrawing = true;
            document.body.style.userSelect = 'none';
            spawnPixel(e.clientX, e.clientY, true);
            state.lastX = e.clientX;
            state.lastY = e.clientY;
          }
        }
        
        function handleMouseUp() {
          state.isDrawing = false;
          document.body.style.userSelect = '';
        }
        
        function handleMouseLeave() {
          state.isDrawing = false;
          document.body.style.userSelect = '';
          // Reset last position when mouse leaves
          state.lastX = null;
          state.lastY = null;
        }
        
        function init() {
          // Only add event listeners once
          if (!state.initialized) {
            window.addEventListener('resize', resizeCanvas);
            window.addEventListener('mousemove', handleMouseMove);
            window.addEventListener('mousedown', handleMouseDown);
            window.addEventListener('mouseup', handleMouseUp);
            window.addEventListener('mouseleave', handleMouseLeave);
            state.initialized = true;
            render();
          }
          resizeCanvas();
        }
        
        // Initialize
        init();
        
        // Re-initialize canvas size after Astro page transitions
        document.addEventListener('astro:page-load', resizeCanvas);
      })();
    </script>
  </body>
</html>
