---
import '../styles/styles.css';
import '../styles/landing.css';
import { ClientRouter } from 'astro:transitions';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <title>jamms</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <ClientRouter />
  </head>
  <body class="landing-body">
    <canvas id="pixel-trail" style="
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      pointer-events: none;
      z-index: 0;
    "></canvas>

    <slot />

    <script is:inline>
      (function() {
        if (!window.__pixelTrail) {
          window.__pixelTrail = {
            pixels: {}, isDrawing: false, animationId: null,
            initialized: false, lastX: null, lastY: null
          };
        }
        const state = window.__pixelTrail;
        const PIXEL_SIZE = 24;
        const MAX_OPACITY = 0.10;
        const DRAW_OPACITY = 0.24;
        const FADE_RATE = 0.002;
        const PIXEL_COLOR = { r: 255, g: 76, b: 156 };
        const INTERACTIVE_SELECTORS = 'a, button, input, [onclick], [role="button"]';

        function getCanvas() { return document.getElementById('pixel-trail'); }
        function resizeCanvas() {
          const c = getCanvas();
          if (c) { c.width = window.innerWidth; c.height = window.innerHeight; }
        }
        function getGridKey(x, y) {
          return Math.floor(x / PIXEL_SIZE) + ',' + Math.floor(y / PIXEL_SIZE);
        }
        function spawnPixel(x, y, drawing) {
          const key = getGridKey(x, y);
          const target = drawing ? DRAW_OPACITY : MAX_OPACITY;
          if (!state.pixels[key] || state.pixels[key].opacity < target * 0.5 || drawing) {
            state.pixels[key] = {
              gridX: Math.floor(x / PIXEL_SIZE),
              gridY: Math.floor(y / PIXEL_SIZE),
              opacity: target * 0.7,
              permanent: drawing
            };
          }
        }
        function drawLine(x0, y0, x1, y1, drawing) {
          const dx = x1 - x0, dy = y1 - y0;
          const steps = Math.max(1, Math.ceil(Math.sqrt(dx*dx+dy*dy) / (PIXEL_SIZE * 0.5)));
          for (let i = 0; i <= steps; i++) {
            const t = i / steps;
            spawnPixel(x0 + dx * t, y0 + dy * t, drawing);
          }
        }
        function render() {
          const c = getCanvas();
          if (!c) { requestAnimationFrame(render); return; }
          const ctx = c.getContext('2d');
          ctx.clearRect(0, 0, c.width, c.height);
          for (const key in state.pixels) {
            const p = state.pixels[key];
            if (!p.permanent) { p.opacity -= FADE_RATE; if (p.opacity <= 0) { delete state.pixels[key]; continue; } }
            ctx.fillStyle = `rgba(${PIXEL_COLOR.r},${PIXEL_COLOR.g},${PIXEL_COLOR.b},${p.opacity})`;
            ctx.fillRect(p.gridX * PIXEL_SIZE, p.gridY * PIXEL_SIZE, PIXEL_SIZE, PIXEL_SIZE);
          }
          requestAnimationFrame(render);
        }
        function init() {
          if (!state.initialized) {
            window.addEventListener('resize', resizeCanvas);
            window.addEventListener('mousemove', e => {
              if (state.lastX !== null) drawLine(state.lastX, state.lastY, e.clientX, e.clientY, state.isDrawing);
              else spawnPixel(e.clientX, e.clientY, state.isDrawing);
              state.lastX = e.clientX; state.lastY = e.clientY;
            });
            window.addEventListener('mousedown', e => {
              if (!e.target.closest(INTERACTIVE_SELECTORS)) {
                state.isDrawing = true;
                document.body.style.userSelect = 'none';
                spawnPixel(e.clientX, e.clientY, true);
              }
            });
            window.addEventListener('mouseup', () => { state.isDrawing = false; document.body.style.userSelect = ''; });
            window.addEventListener('mouseleave', () => { state.isDrawing = false; state.lastX = null; state.lastY = null; });
            state.initialized = true;
            render();
          }
          resizeCanvas();
        }
        init();
        document.addEventListener('astro:page-load', resizeCanvas);
      })();
    </script>
  </body>
</html>
