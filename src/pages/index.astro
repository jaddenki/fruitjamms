            <!-- Section tabs: horizontal bar at top of panel -->
            <nav id="side-tabs" aria-label="Sections" aria-hidden="true">
                <button
                    class="tab-btn active"
                    data-tab="work"
                    aria-pressed="true">work</button
                >
                <button class="tab-btn" data-tab="team" aria-pressed="false"
                    >about</button
                >
                <button class="tab-btn" data-tab="about" aria-pressed="false"
                    >blog</button
                >
                <button id="close-btn" aria-label="Close menu">
                    <svg
                        width="14"
