---
import Layout from "../layouts/Layout.astro";
---

<Layout title="jamms" subtitle="we're friends who make cool games together!">
    <!-- PROJECTS -->
    <section class="other-projects">
        <div class="projects-grid">
            <!-- Spread The Love -->
            <div class="project-card">
                <h4 class="project-title">Spread The Love</h4>
                <div class="project-description">
                    <p>
                        a dating sim where you get matched with someone based on
                        a personality quiz about jams.
                    </p>
                </div>

                <div class="video-container">
                    <iframe
                        src="https://www.youtube.com/embed/MQsOGCQESOU?si=EaK_47q7OA_9MwRP"
                        title="Spread The Love Trailer"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                    >
                    </iframe>
                </div>

                <div class="project-links">
                    <a href="/quiz" class="project-link">Take the quiz here!</a>
                    <a
                        href="https://store.steampowered.com/app/3852520/Spread_The_Love/"
                        target="_blank"
                        class="project-link"
                    >
                        Steam Page
                    </a>
                </div>

                <!-- <div class="credits">
					<p class="credits-text">
						made with &lt;3 by
						<a href="https://x.com/anullja" target="_blank" class="credit-link">saahil</a>,
						<a href="https://jadden.xyz" target="_blank" class="credit-link">jadden</a>,
						<a href="https://aliciazhou.xyz" target="_blank" class="credit-link">alicia</a>, and
						<a href="https://x.com/randompossibly" target="_blank" class="credit-link">mason</a>
					</p>
				</div> -->
            </div>

            <!-- ETea -->
            <div class="project-card">
                <h4 class="project-title">ETea</h4>
                <div class="project-description">
                    <p>
                        you're an alien who got stuck on earth & now you work at
                        a boba shop while pretending to be human.
                    </p>
                </div>

                <div class="video-container">
                    <iframe
                        src="https://www.youtube.com/embed/XQC0lC0ZThI?si=EaK_47q7OA_9MwRP"
                        title="ETea Teaser"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                    >
                    </iframe>
                </div>

                <div class="project-links">
                    <a
                        href="https://store.steampowered.com/app/3085040/ETea/"
                        target="_blank"
                        class="project-link"
                    >
                        Steam Page
                    </a>
                </div>
                <!-- <div class="credits">
					<p class="credits-text">
						in progress... stay tuned!
					</p>
				</div> -->
            </div>
        </div>
    </section>
</Layout>
