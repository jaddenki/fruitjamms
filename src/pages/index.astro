---
import AboutBlurb from "../components/AboutBlurb.astro";
import CrossScene from "../components/CrossScene.astro";
import GooPixels from "../components/GooPixels.astro";
import IntroCorner from "../components/IntroCorner.astro";
import NavPill from "../components/NavPill.astro";
import FluidSim from "../components/FluidSim.astro";

// Edit this grid to reshape the mascot.
// Each row is a string of 10 chars: 'X' = filled, '.' = empty.
const mascotGrid = [
    ".X..X.....", // row 0  antennae
    ".XXXX.....", // row 1  head
    "X....X....", // row 2  full
    "X....X....", // row 3  body (window sides)
    ".XXXX.....", // row 4  body (window sides)
    "X....X....", // row 5  body (window sides)
    "..........", // row 6  lower body
    "..........", // row 7  base
    "..........", // row 8  feet
];

---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/img/favicon.png" />
        <title>jamms</title>
        <script type="importmap" is:inline>
            { "imports": { "three": "https://esm.sh/three@0.170.0" } }
        </script>
        <style is:global>
            @font-face {
                font-family: "Authentic Sans";
                src: url("/fonts/authentic-sans-60.otf") format("opentype");
                font-weight: normal;
                font-display: swap;
            }
            @font-face {
                font-family: "Authentic Sans";
                src: url("/fonts/authentic-sans-90.otf") format("opentype");
                font-weight: bold;
                font-display: swap;
            }
            *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
            :root {
                --frame: 14px;
                --frame-radius: 20px;
                --panel-w: 240px;
            }
            html, body {
                width: 100%;
                height: 100%;
                overflow: hidden;
                background: #ffffff;
                font-family: "Authentic Sans", sans-serif;
                letter-spacing: -0.05em;
            }
            ::selection { background: #ff28a8; color: #ffffff; }

            /* Subtle grain overlay */
            body::after {
                content: "";
                position: fixed;
                inset: 0;
                pointer-events: none;
                z-index: 200;
                opacity: 0.055;
                background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
                background-size: 128px 128px;
            }

            /* ── Fluid background canvas ── */
            #fluid-bg {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                display: block;
            }

            /* ── White frame + black stage ── */
            #stage {
                position: fixed;
                inset: var(--frame);
                background: #050005;
                border-radius: var(--frame-radius);
                z-index: 0;
                cursor: default;
            }

            /* ── Scene (crosses + mascot, clipped to stage) ── */
            #scene {
                position: fixed;
                inset: var(--frame);
                border-radius: var(--frame-radius);
                overflow: hidden;
                pointer-events: none;
                z-index: 1;
            }
            .cross-wrap,
            #mascot {
                position: absolute;
                will-change: transform;
                pointer-events: auto;
                cursor: grab;
                touch-action: none;
            }
            .cross-wrap.is-pulling,
            #mascot.is-pulling {
                cursor: grabbing;
            }
            .cross-wrap svg,
            #mascot svg {
                overflow: visible;
            }
            /* Mascot: gentle bob + squish (inner svg only) */
            @keyframes mascot-bob {
                0%, 100% { transform: translateY(0) scaleY(1) scaleX(1); }
                35%       { transform: translateY(-9px) scaleY(1.05) scaleX(0.97); }
                65%       { transform: translateY(-6px) scaleY(1.02) scaleX(0.99); }
            }
            #mascot svg {
                animation: mascot-bob 3.8s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
                transform-origin: bottom center;
            }
            @media (prefers-reduced-motion: reduce) {
                .cross-wrap { animation: none !important; }
                #mascot svg { animation: none !important; }
            }

            /* ── Gooey backdrop: white bar melds into the white bottom frame ── */
            #nav-goo {
                position: fixed;
                inset: 0;
                z-index: 45;
                pointer-events: none;
                filter: url(#menu-goo);
            }
            .nav-goo-frame,
            .nav-goo-riser {
                position: fixed;
                background: #ffffff;
                will-change: transform, top, height, left, width;
            }
            /* Closed-state geometry so the goo is correct on first paint,
               before the JS sync loop takes over (avoids a load flash). */
            .nav-goo-frame {
                bottom: 0;
                height: 16px;
                left: calc(50% - 171px);
                width: 342px;
            }
            .nav-goo-riser {
                border-radius: 18px 18px 0 0;
                left: calc(50% - 145px);
                width: 290px;
                top: calc(100vh - 40px);
                height: 56px;
            }
            @media (prefers-reduced-motion: reduce) {
                #nav-goo { display: none; }
            }

            /* ── Nav pill (morphs into panel) ── */
            #nav-pill {
                position: fixed;
                bottom: -16px;
                left: 50%;
                transform: translateX(-50%);
                width: 290px;
                height: 56px;
                background: #ffffff;
                border-radius: 18px 18px 0 0;
                cursor: pointer;
                z-index: 50;
                overflow: hidden;
                border: none;
                outline: none;
            }
            #nav-pill.is-open { cursor: default; }
            #nav-pill:not(.is-open) {
                transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            }
            #nav-pill:not(.is-open):hover {
                transform: translateX(-50%) translateY(-10px);
            }
            #nav-pill:not(.is-open):active {
                transform: translateX(-50%) translateY(-4px);
                transition: transform 0.12s ease-out;
            }

            /* ── Pill icon ── */
            #pill-icon {
                position: absolute;
                bottom: 22px;
                left: 50%;
                transform: translateX(-50%);
                pointer-events: none;
            }

            /* ── Menu panel ── */
            #menu-panel {
                position: absolute;
                inset: 0;
                background: #ffffff;
                opacity: 0;
                pointer-events: none;
                border-radius: inherit;
                overflow: hidden;
            }
            #work-grid {
                position: absolute;
                top: 44px;
                left: 0;
                right: 0;
                bottom: 0;
                overflow-y: auto;
                padding: 20px 20px 40px 20px;
                display: flex;
                flex-direction: column;
                gap: 0;
                scrollbar-width: none;
            }
            #work-grid::-webkit-scrollbar { display: none; }

            #tag-filter-row {
                display: flex;
                flex-wrap: nowrap;
                align-items: stretch;
                gap: 6px;
                margin: 0 0 4px;
            }
            .tag-filter-btn {
                flex: 1 1 0;
                font-family: "Authentic Sans", sans-serif;
                font-size: 11px;
                font-weight: bold;
                letter-spacing: -0.03em;
                padding: 6px 4px;
                border-radius: 999px;
                border: 1px solid transparent;
                background: #e8e8e8;
                color: #4a4a4a;
                cursor: pointer;
                text-align: center;
                white-space: nowrap;
                text-transform: lowercase;
                transition: transform 0.15s ease-out, border-color 0.15s, color 0.15s, background 0.15s;
            }
            .tag-filter-btn:hover:not(.active) {
                background: #dcdcdc;
                color: #333333;
            }
            .tag-filter-btn.active {
                background: #000000;
                border-color: #000000;
                color: #ffffff;
            }
            .tag-filter-btn:active {
                transform: scale(0.94);
            }

            .work-item {
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                gap: 12px;
                padding: 14px 0;
                border-bottom: 1px solid rgba(0, 0, 0, 0.08);
                text-decoration: none;
                color: inherit;
                cursor: default;
                flex-shrink: 0;
                transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1);
            }
            .work-item:first-child { border-top: 1px solid rgba(0, 0, 0, 0.08); }
            a.work-item { cursor: pointer; }
            a.work-item:hover { transform: translateX(6px); }
            a.work-item:active {
                transform: translateX(3px) scale(0.98);
                transition: transform 0.1s ease-out;
            }
            a.work-item:hover .work-label { color: #ff28a8; }
            .work-label {
                font-size: 14px;
                font-weight: bold;
                letter-spacing: -0.05em;
                color: #000000;
                transition: color 0.12s ease-out;
            }
            .work-tags {
                display: flex;
                gap: 6px;
                flex-shrink: 0;
            }
            .tag-chip {
                font-size: 11px;
                font-weight: bold;
                letter-spacing: -0.03em;
                color: #ffffff;
                padding: 4px 10px;
                border-radius: 999px;
                text-transform: lowercase;
            }

            /* ── Floating work preview ── */
            #work-preview {
                position: fixed;
                pointer-events: none;
                z-index: 300;
                opacity: 0;
                width: 280px;
                aspect-ratio: 16 / 9;
                border-radius: 14px;
                overflow: hidden;
                background: #000000;
                transform-origin: bottom left;
            }
            #work-preview img,
            #work-preview video {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
            #work-preview img,
            #work-preview video {
                display: none;
            }
            #work-preview.showing-img img { display: block; }
            #work-preview.showing-video video { display: block; }

            /* ── Tabs ── */
            #side-tabs {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                background: #ff28a8;
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: center;
                padding: 0;
                gap: 0;
                z-index: 51;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }
            .tab-btn {
                writing-mode: horizontal-tb;
                font-family: "Authentic Sans", sans-serif;
                font-weight: bold;
                font-size: 14px;
                letter-spacing: -0.05em;
                color: rgba(255, 255, 255, 0.5);
                background: none;
                border: none;
                cursor: pointer;
                padding: 14px 18px;
                transition: color 0.15s, transform 0.18s cubic-bezier(0.23, 1, 0.32, 1);
                text-transform: lowercase;
            }
            .tab-btn.active { color: #ffffff; }
            .tab-btn:hover:not(.active) { color: #ffffff; transform: scale(1.08); }
            .tab-btn:active { transform: scale(0.94); transition: transform 0.1s ease-out; }

            /* ── Team panel ── */
            #team-panel {
                display: none;
                position: absolute;
                top: 44px;
                left: 0;
                right: 0;
                bottom: 0;
                padding: 16px 20px 40px 20px;
                flex-direction: column;
                overflow-y: auto;
                scrollbar-width: none;
            }
            #team-panel::-webkit-scrollbar { display: none; }
            #team-panel.visible { display: flex; }
            #team-blurb {
                font-size: 14px;
                line-height: 1.5;
                letter-spacing: -0.05em;
                color: #000000;
                padding: 12px 0 4px;
            }
            #team-contact-line {
                font-size: 14px;
                letter-spacing: -0.05em;
                color: #000000;
                margin-top: 16px;
            }
            #team-contact {
                font-family: "Authentic Sans", sans-serif;
                font-size: 14px;
                font-weight: normal;
                letter-spacing: -0.05em;
                color: #000000;
                background: none;
                border: none;
                padding: 0;
                cursor: pointer;
                transition: color 0.12s ease-out;
            }
            #team-contact:hover { color: #ff28a8; }
            #team-contact.copied { color: #ff28a8; }
            .team-row {
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                padding: 12px 0;
                border-bottom: 1px solid rgba(0, 0, 0, 0.08);
                text-decoration: none;
                color: inherit;
                cursor: pointer;
                transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1);
            }
            .team-row:hover { transform: translateX(6px); }
            .team-row:active { transform: translateX(3px) scale(0.98); transition: transform 0.1s ease-out; }
            .team-row:first-child { border-top: 1px solid rgba(0, 0, 0, 0.08); }
            .team-name { font-size: 14px; font-weight: bold; color: #000000; letter-spacing: -0.05em; transition: color 0.12s ease-out; }
            .team-row:hover .team-name { color: #ff28a8; }
            .team-role { font-size: 14px; color: rgba(0, 0, 0, 0.4); letter-spacing: -0.05em; transition: color 0.12s ease-out; }
            .team-row:hover .team-role { color: #ff28a8; }

            /* ── Floating member preview ── */
            #member-preview {
                position: fixed;
                pointer-events: none;
                z-index: 300;
                opacity: 0;
                width: 120px;
                height: 120px;
                transform-origin: bottom left;
            }
            #member-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }

            /* ── Scroll rail ── */
            #scroll-rail {
                position: fixed;
                left: calc(50% + var(--panel-w) / 2 + 18px);
                bottom: 10vh;
                height: 62vh;
                width: 8px;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.1);
                z-index: 49;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }
            #scroll-thumb {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                height: 30%;
                border-radius: 999px;
                background: #ffffff;
            }

            /* ── Close button ── */
            #close-btn {
                margin-left: auto;
                background: none;
                border: none;
                cursor: pointer;
                padding: 14px 16px;
                line-height: 0;
                opacity: 0.4;
                transition: opacity 0.15s, transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
            }
            #close-btn:hover { opacity: 1; transform: rotate(90deg) scale(1.15); }
            #close-btn:active { transform: rotate(90deg) scale(0.9); transition: transform 0.1s ease-out; }
        </style>
    </head>
    <body>
        <div id="stage" aria-hidden="true"></div>
        <GooPixels />
        <CrossScene mascotGrid={mascotGrid} />
        <IntroCorner />
        <AboutBlurb />
        <NavPill />
        <FluidSim />
    </body>
</html>
