---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title=": etea">
  <div class="project-detail">
    <a href="/projects" class="link-muted link-purple">&lt; back</a>
    
    <div class="project-header">
      <img src="/img/Group 2.svg" alt="" class="icon icon-md" />
      <h1 class="project-title" style="color: #8240B9;">ETea</h1>
    </div>
    
    <p class="project-description">
      you're an alien who got stuck on earth & now you work at a boba shop while pretending to be human. 
    </p>
    
    <div class="project-links">
      <a href="https://store.steampowered.com/app/3085040/ETea/" target="_blank" class="link-dark link-purple">Steam</a>
    </div>
  </div>
</BaseLayout>

<style>
  .link-purple:hover {
    color: #8240B9 !important;
  }
</style>
