---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title=" quiz"
  description="take the Spread the Love personality quiz and get matched based on your taste in jams."
>
  <div class="quiz-page">
    <a href="/projects/spread-the-love" class="link-muted">&lt; back</a>
    
    <!-- Mobile message -->
    <div id="mobile-message" class="mobile-message">
      <p class="mobile-title">oops!</p>
      <p class="mobile-text">
        this quiz doesn't work on mobile devices.
      </p>
      <p class="mobile-text">
        please open this page on a pc to take the quiz!
      </p>
    </div>

    <!-- Desktop quiz -->
    <div id="quiz-container-wrapper" class="quiz-container">
      <div id="unity-container">
        <canvas id="unity-canvas" tabindex="-1"></canvas>
        <div id="unity-loading-bar">
          <div id="unity-progress-bar-empty">
            <div id="unity-progress-bar-full"></div>
          </div>
        </div>
        <div id="unity-warning"></div>
      </div>
      <div class="quiz-controls">
        <button id="fullscreen-btn" class="link-dark">fullscreen</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .quiz-page {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .quiz-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Mobile message - hidden by default, shown via JS on mobile */
  .mobile-message {
    display: none;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
    background: #f5f5f5;
    text-align: center;
  }

  .mobile-title {
    font-size: 24px;
    color: var(--accent-pink);
  }

  .mobile-text {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.8;
  }

  #unity-container {
    position: relative;
    width: 960px;
    height: 600px;
    max-width: 100%;
    background: #1a1a1a;
  }

  #unity-canvas {
    width: 960px;
    height: 600px;
    max-width: 100%;
    background: #1a1a1a;
  }

  #unity-loading-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: none;
  }

  #unity-progress-bar-empty {
    width: 200px;
    height: 12px;
    background: #333;
  }

  #unity-progress-bar-full {
    width: 0%;
    height: 100%;
    background: var(--accent-pink);
  }

  #unity-warning {
    position: absolute;
    left: 50%;
    top: 10px;
    transform: translateX(-50%);
    font-size: 16px;
  }

  .quiz-controls {
    display: flex;
    gap: 24px;
  }

  #fullscreen-btn {
    font-family: var(--font-pixel);
    font-size: 24px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-dark);
  }

  #fullscreen-btn:hover {
    color: var(--accent-pink);
  }

  @media (max-width: 1000px) {
    #unity-container,
    #unity-canvas {
      width: 100%;
      height: auto;
      aspect-ratio: 960 / 600;
    }
  }

  @media (max-width: 600px) {
    .quiz-page {
      gap: 16px;
    }

    .quiz-container {
      gap: 12px;
    }

    #unity-progress-bar-empty {
      width: 150px;
      height: 8px;
    }

    #fullscreen-btn {
      font-size: 12px;
    }

    .mobile-message {
      padding: 24px 16px;
    }

    .mobile-title {
      font-size: 18px;
    }

    .mobile-text {
      font-size: 12px;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const quizWrapper = document.querySelector("#quiz-container-wrapper") as HTMLElement;
    const mobileMessage = document.querySelector("#mobile-message") as HTMLElement;
    const container = document.querySelector("#unity-container");
    const canvas = document.querySelector("#unity-canvas") as HTMLCanvasElement;
    const loadingBar = document.querySelector("#unity-loading-bar") as HTMLElement;
    const progressBarFull = document.querySelector("#unity-progress-bar-full") as HTMLElement;
    const fullscreenButton = document.querySelector("#fullscreen-btn");
    const warningBanner = document.querySelector("#unity-warning") as HTMLElement;

    if (!quizWrapper || !mobileMessage) return;

    // Check if mobile device
    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);

    if (isMobile) {
      // Show mobile message, hide quiz
      mobileMessage.style.display = 'flex';
      quizWrapper.style.display = 'none';
      return;
    }

    // Desktop: load the quiz
    if (!canvas || !loadingBar || !progressBarFull || !warningBanner) return;

    function unityShowBanner(msg: string, type: string) {
      function updateBannerVisibility() {
        warningBanner.style.display = warningBanner.children.length ? 'block' : 'none';
      }
      const div = document.createElement('div');
      div.innerHTML = msg;
      warningBanner.appendChild(div);
      if (type == 'error') div.style.cssText = 'background: red; padding: 10px;';
      else {
        if (type == 'warning') div.style.cssText = 'background: yellow; padding: 10px;';
        setTimeout(function() {
          warningBanner.removeChild(div);
          updateBannerVisibility();
        }, 5000);
      }
      updateBannerVisibility();
    }

    const buildUrl = "/STLWeb/Build";
    const loaderUrl = buildUrl + "/STLWeb.loader.js";
    const config = {
      dataUrl: buildUrl + "/STLWeb.data.unityweb",
      frameworkUrl: buildUrl + "/STLWeb.framework.js.unityweb",
      codeUrl: buildUrl + "/STLWeb.wasm.unityweb",
      streamingAssetsUrl: "/STLWeb/StreamingAssets",
      companyName: "Jamms",
      productName: "SpreadTheLove",
      productVersion: "1.0",
      showBanner: unityShowBanner,
    };

    loadingBar.style.display = "block";

    const script = document.createElement("script");
    script.src = loaderUrl;
    script.onload = () => {
      (window as any).createUnityInstance(canvas, config, (progress: number) => {
        progressBarFull.style.width = 100 * progress + "%";
      }).then((unityInstance: any) => {
        loadingBar.style.display = "none";
        if (fullscreenButton) {
          fullscreenButton.addEventListener('click', () => {
            unityInstance.SetFullscreen(1);
          });
        }
      }).catch((message: string) => {
        alert(message);
      });
    };

    document.body.appendChild(script);
  });
</script>
