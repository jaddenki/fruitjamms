---
import Layout from '../layouts/Layout.astro';
---

<Layout title="team | jamms" subtitle="meet the people behind fruit jamms">
	<div class="team-grid">
		<!-- Jadden -->
		<div class="team-member">
			<a href="https://jadden.xyz" target="_blank" class="member-image-link">
				<img src="/img/jadden.png" alt="jadden" class="member-image" />
			</a>
			<h2 class="member-name">jadden</h2>
			<div class="member-roles">
				<div class="member-role">co-director</div>
				<div class="member-role">creative direction & programming</div>
			</div>
		</div>
		
		<!-- Saahil -->
		<div class="team-member">
			<a href="https://x.com/anullja" target="_blank" class="member-image-link">
				<img src="/img/saahil.png" alt="saahil" class="member-image" />
			</a>
			<h2 class="member-name">saahil</h2>
			<div class="member-roles">
				<div class="member-role">co-director</div>
				<div class="member-role">game design & programming</div>
			</div>
		</div>
		
		<!-- Alicia -->
		<div class="team-member">
			<a href="https://aliciazhou.xyz" target="_blank" class="member-image-link">
				<img src="/img/alicia.png" alt="alicia" class="member-image" />
			</a>
			<h2 class="member-name">alicia</h2>
			<div class="member-roles">
				<div class="member-role">character & environment artist</div>
			</div>
		</div>
		
		<!-- Mason -->
		<div class="team-member">
			<a href="https://x.com/randompossibly" target="_blank" class="member-image-link">
				<img src="/img/mason.png" alt="mason" class="member-image" />
			</a>
			<h2 class="member-name">emji</h2>
			<div class="member-roles">
				<div class="member-role">lead composer</div>
			</div>
		</div>
	</div>
</Layout>
