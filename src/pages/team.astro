---
import BaseLayout from '../layouts/BaseLayout.astro';

const team = [
  {
    name: 'jadden',
    role: 'co director',
    avatar: '/img/jadden.png',
    link: 'https://jadden.xyz'
  },
  {
    name: 'saahil',
    role: 'co director',
    avatar: '/img/saahil.png',
    link: 'https://saahil.xyz'
  },
  {
    name: 'alicia',
    role: 'lead artist',
    avatar: '/img/alicia.png',
    link: 'https://aliciazhou.xyz'
  },
  {
    name: 'mason',
    role: 'lead composer',
    avatar: '/img/mason.png',
    link: 'https://x.com/RandomPossibly'
  }
];
---

<BaseLayout title=" team">
  <div class="team-grid">
    {team.map((member) => (
      <a href={member.link} target="_blank" class="team-member">
        <div class="avatar-wrapper">
          <img src={member.avatar} alt={member.name} class="avatar" />
        </div>
        <span class="member-name">{member.name}</span>
        <span class="member-role">{member.role}</span>
      </a>
    ))}
  </div>
</BaseLayout>
